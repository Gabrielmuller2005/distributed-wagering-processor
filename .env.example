# Aplicação
NODE_ENV=development
# fatal, error, warn, info, debug, trace ou silent
LOG_LEVEL=info
HTTP_PORT=3000

# Papéis da instância (apenas "true" ou "false")
ENABLE_HTTP=true
ENABLE_OUTBOX_PUBLISHER=true
ENABLE_SQS_CONSUMER=true
ENABLE_PENDING_REFERENCE_WORKER=true

# PostgreSQL
POSTGRES_PORT=5432
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DB_POOL_MAX=10
# Espera máxima por lock de linha em cada transação (ms)
DB_LOCK_TIMEOUT_MS=5000

# AWS (emulador local MiniStack; credenciais fictícias)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# SQS
SQS_PORT=4566
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wager-events.fifo
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_CONSUMER_BATCH_SIZE=10
SQS_WAIT_TIME_SECONDS=10

# Worker de PENDING_REFERENCE
# Prazo para a referência chegar (ms), contado da aceitação da transação
PENDING_REFERENCE_TTL_MS=900000
PENDING_REFERENCE_BATCH_SIZE=20
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
# Reserva de um lote (ms): se o worker morrer, outro assume depois disso
PENDING_REFERENCE_LEASE_MS=30000

# Publisher da outbox
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=500
# Reserva de um lote (ms): precisa ser maior que o timeout de publicação
OUTBOX_LEASE_MS=30000
OUTBOX_PUBLISH_TIMEOUT_MS=10000
