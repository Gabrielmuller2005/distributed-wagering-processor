{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:money": "bun run scripts/check-money.ts",
    "check": "bun run typecheck && bun run lint && bun run check:money && bun test",
    "test": "bun test",
    "test:unit": "bun test --pass-with-no-tests test/unit",
    "test:integration": "bun test --pass-with-no-tests test/integration",
    "test:concurrency": "bun test --pass-with-no-tests test/concurrency",
    "test:load": "bun run scripts/load-test.ts",
    "infra:up": "docker compose up -d --wait && bun run infra:queues",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:queues": "bun run scripts/setup-queues.ts",
    "db:migrate": "bun run scripts/migrate.ts up",
    "db:migrate:down": "bun run scripts/migrate.ts down",
    "db:migrate:status": "bun run scripts/migrate.ts status"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1168.0",
    "@mikro-orm/core": "7.2.9",
    "@mikro-orm/migrations": "7.2.9",
    "@mikro-orm/postgresql": "7.2.9",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "decimal.js": "10.6.0",
    "pino": "9.14.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
