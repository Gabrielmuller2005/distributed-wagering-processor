{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "test:unit": "bun test --pass-with-no-tests test/unit",
    "test:integration": "bun test --pass-with-no-tests test/integration",
    "test:concurrency": "bun test --pass-with-no-tests test/concurrency",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:queues": "bun run scripts/setup-queues.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1168.0",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
